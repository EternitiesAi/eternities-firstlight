# pins for the firstlight score and effects. change a pin only with a new smoke test and a new hash record.
# ace-step: github ace-step/ACE-Step, apache-2.0 (LICENSE checked on the box into out/ace-license.txt).
ACE_REPO=https://github.com/ace-step/ACE-Step.git
ACE_SHA=1bee4c9f5b43e30995f8d4d33b3919197ce1bd68
# model: huggingface ACE-Step/ACE-Step-v1-3.5B, card license apache-2.0 at this revision.
ACE_MODEL=ACE-Step/ACE-Step-v1-3.5B
ACE_MODEL_REV=82cd0d7b6322bd28cd4e830fe675ddb6180ce36c
# torch built for the box driver (nvidia 595, cuda 13 capable; cu128 wheels run on it).
TORCH_VERSION=2.8.0
TORCH_INDEX=https://download.pytorch.org/whl/cu128
