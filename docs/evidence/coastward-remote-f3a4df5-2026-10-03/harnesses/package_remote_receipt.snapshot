assert W.is_dir() and not O.exists(),'Use the new dedicated evidence worktree'
receipt=json.loads((R/'FULL_GATE_RECEIPT.json').read_text(encoding='utf8'))
hosted=json.loads((R/'HOSTED_RECEIPT.json').read_text(encoding='utf8'))
assert receipt['passed'] and receipt['head']=='f3a4df5f8023b385ea5273aa6d90ba5ddf438121'
assert hosted['head']==receipt['head'] and hosted['executed_steps']==0
assert receipt['browser_count']==38 and not receipt['collection_errors']
O.mkdir(parents=True)
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
copies=[]
def cp(src,dest):
    src=src.resolve();dst=O/dest;dst.parent.mkdir(parents=True,exist_ok=True)
    assert src.is_file() and not dst.exists(),str(dst)
    shutil.copyfile(src,dst);assert sha(src)==sha(dst)
    copies.append({'source':str(src),'file':dst.relative_to(O).as_posix(),'bytes':dst.stat().st_size,'sha256':sha(dst)})
for name in ['FULL_GATE_RECEIPT.json','SUMMARY.md','START_MANIFEST.json','RUN.json','FULL_VERIFY_CONSOLE.log','REMOTE_CLONE_LOG.txt','DEFAULT_MODE_ENVIRONMENT.json','DELIVERY_DIFF.json','collect_full_gate.py']:
    cp(R/name,Path(name))
for p in sorted((R/'commands').glob('*.log')):cp(p,Path('commands')/p.name)
for row in receipt['browser_suites']:
    p=(C/row['report']).resolve();assert p.is_relative_to(C.resolve()),row['report']
    assert sha(p)==row['report_sha256']
    cp(p,Path('browser-reports')/(row['suite']+'.json'))
for name in ['HOSTED_RUNS_CURRENT.json','HOSTED_JOBS_FINAL.json','HOSTED_ANNOTATIONS_FINAL.json','HOSTED_RECEIPT.json']:
    cp(R/name,Path('hosted')/name)
